#include "Shared.xcconfig"

// ==========================================
// Test Target Settings (Customizable by scaffold tool)
// ==========================================
// Xcode derives the UI runner's .xctrunner identifier from the same isolated base.
PRODUCT_BUNDLE_IDENTIFIER = $(NOTCHIUM_APP_BUNDLE_IDENTIFIER)
TEST_TARGET_NAME = Notchium

// Fix duplicate module name issue
PRODUCT_MODULE_NAME = $(PRODUCT_NAME)UITests
SWIFT_VERSION = 6.0
SWIFT_STRICT_CONCURRENCY = complete
